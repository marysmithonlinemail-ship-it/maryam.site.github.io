<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>DAA About Page</title>
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700;900&family=Source+Sans+3:wght@400;600&display=swap">
  <style>
    :root {
      --navy-dark: #0A1628;
      --navy-mid:  #1B3A6B;
      --red:       #C8102E;
      --off-white: #F4F6F9;
      --white:     #FFFFFF;
      --text-main: #1a1a2e;
      --text-muted:#4a5568;
      --border:    #d1d9e6;
      --font-head: 'Inter', sans-serif;
      --font-body: 'Source Sans 3', sans-serif;
    }

    * { box-sizing: border-box; margin: 0; padding: 0; }

    body {
      font-family: var(--font-body);
      font-size: 16px;
      line-height: 1.6;
      background: var(--off-white);
      color: var(--text-main);
    }

    img { max-width: 100%; }

    /* GOV BAR */
    .gov-bar {
      background: var(--navy-dark);
      color: #a0b4cc;
      font-family: var(--font-head);
      font-size: 11px;
      letter-spacing: 0.08em;
      padding: 6px 24px;
      display: flex;
      align-items: center;
      gap: 8px;
    }
    .gov-bar strong { color: #fff; }
    .gov-bar span { opacity: 0.6; }

    /* HEADER */
    .site-header {
      background: var(--navy-dark);
      border-bottom: 3px solid var(--red);
      padding: 20px 40px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      flex-wrap: wrap;
      gap: 16px;
    }

    .site-logo { display: flex; align-items: center; gap: 16px; }

    .seal {
      width: 56px;
      height: 56px;
      border: 2px solid var(--red);
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
      color: #fff;
      font-family: var(--font-head);
      font-size: 13px;
      font-weight: 900;
    }

    .agency-name { color: #fff; font-family: var(--font-head); }
    .agency-name .short { font-size: 22px; font-weight: 900; letter-spacing: 0.06em; }
    .agency-name .long  { font-size: 11px; letter-spacing: 0.1em; opacity: 0.7; text-transform: uppercase; margin-top: 2px; }

    nav { display: flex; gap: 28px; flex-wrap: wrap; }
    nav a {
      color: #94b4d4;
      font-family: var(--font-head);
      font-size: 13px;
      font-weight: 600;
      letter-spacing: 0.06em;
      text-decoration: none;
      text-transform: uppercase;
    }
    nav a.active { color: #fff; border-bottom: 2px solid var(--red); padding-bottom: 2px; }
    nav a:hover  { color: #fff; }

    /* HERO */
    .page-hero {
      background: var(--navy-mid);
      color: #fff;
      padding: 48px 64px;
      border-bottom: 1px solid rgba(200,16,46,0.3);
    }

    .breadcrumb {
      font-family: var(--font-head);
      font-size: 11px;
      letter-spacing: 0.1em;
      text-transform: uppercase;
      color: rgba(255,255,255,0.5);
      margin-bottom: 16px;
    }
    .breadcrumb span { color: var(--red); }

    .page-hero h1 {
      font-family: var(--font-head);
      font-size: clamp(28px, 4vw, 44px);
      font-weight: 900;
      letter-spacing: -0.02em;
      line-height: 1.1;
      max-width: 680px;
    }

    .page-hero .subtitle {
      margin-top: 14px;
      font-size: 17px;
      color: rgba(255,255,255,0.65);
      max-width: 560px;
      line-height: 1.5;
    }

    /* BODY GRID */
    .page-body {
      max-width: 1160px;
      margin: 0 auto;
      padding: 56px 40px;
      display: grid;
      grid-template-columns: 1fr 300px;
      gap: 64px;
      align-items: start;
    }

    .main-col section { margin-bottom: 48px; }

    .main-col h2 {
      font-family: var(--font-head);
      font-size: 22px;
      font-weight: 700;
      color: var(--navy-dark);
      border-left: 4px solid var(--red);
      padding-left: 14px;
      margin-bottom: 18px;
    }

    .main-col p { color: var(--text-muted); margin-bottom: 14px; line-height: 1.75; }

    /* SIDEBAR */
    .sidebar { display: flex; flex-direction: column; gap: 24px; }

    .info-card {
      background: var(--white);
      border: 1px solid var(--border);
      border-top: 3px solid var(--red);
      padding: 24px;
      border-radius: 2px;
    }

    .info-card h3 {
      font-family: var(--font-head);
      font-size: 11px;
      font-weight: 700;
      letter-spacing: 0.12em;
      text-transform: uppercase;
      color: var(--red);
      margin-bottom: 14px;
    }

    .info-card p { font-size: 14px; color: var(--text-muted); line-height: 1.6; margin-bottom: 10px; }

    .quick-links { list-style: none; display: flex; flex-direction: column; gap: 8px; }
    .quick-links li { border-bottom: 1px solid var(--border); padding-bottom: 8px; }
    .quick-links li:last-child { border-bottom: none; padding-bottom: 0; }
    .quick-links a {
      font-family: var(--font-head);
      font-size: 13px;
      font-weight: 600;
      color: var(--navy-mid);
      text-decoration: none;
      display: flex;
      align-items: center;
      gap: 8px;
    }
    .quick-links a::before { content: "›"; color: var(--red); font-size: 16px; }

    /* STAT ROW */
    .stat-row {
      background: var(--navy-dark);
      color: #fff;
      padding: 48px 64px;
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 40px;
      text-align: center;
    }

    .stat-num {
      font-family: var(--font-head);
      font-size: 48px;
      font-weight: 900;
      color: var(--red);
      line-height: 1;
    }

    .stat-label {
      font-family: var(--font-head);
      font-size: 13px;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      color: rgba(255,255,255,0.55);
      margin-top: 8px;
    }

    /* MISSION CALLOUT */
    .mission-callout {
      background: var(--off-white);
      border-top: 1px solid var(--border);
      border-bottom: 1px solid var(--border);
      padding: 56px 64px;
      text-align: center;
    }

    .mission-callout blockquote {
      font-family: var(--font-head);
      font-size: clamp(18px, 2.5vw, 26px);
      font-weight: 700;
      color: var(--navy-dark);
      max-width: 720px;
      margin: 0 auto;
      line-height: 1.4;
    }

    .mission-callout cite {
      display: block;
      margin-top: 16px;
      font-family: var(--font-head);
      font-size: 12px;
      letter-spacing: 0.1em;
      text-transform: uppercase;
      color: var(--red);
      font-style: normal;
    }

    /* FOOTER */
    footer {
      background: var(--navy-dark);
      color: rgba(255,255,255,0.45);
      font-family: var(--font-head);
      font-size: 12px;
      padding: 32px 40px;
      display: flex;
      justify-content: space-between;
      align-items: center;
      flex-wrap: wrap;
      gap: 12px;
    }

    /* MOBILE */
    @media (max-width: 760px) {
      .site-header, .page-hero, .mission-callout { padding: 20px 16px; }
      .page-body { grid-template-columns: 1fr; gap: 40px; padding: 32px 16px; }
      .stat-row  { grid-template-columns: 1fr; padding: 32px 16px; }
      footer     { padding: 24px 16px; }
    }
  </style>
</head>
